{
  "name": "alasin",
  "version": "1.10.0",
  "private": true,
  "description": "A mobile-first editor for Hugo sites stored in GitHub, hosted on Cloudflare, with images in R2.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "scripts": {
    "prepare": "node scripts/install-hooks.mjs",
    "build": "tsx scripts/alasin.ts build",
    "dev": "tsx scripts/alasin.ts dev",
    "deploy": "tsx scripts/alasin.ts deploy",
    "setup": "tsx scripts/setup/index.ts",
    "create-site": "tsx scripts/create-site.ts",
    "sites": "tsx scripts/sites.ts",
    "skeleton:check": "tsx scripts/skeleton-check.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . && tsx scripts/config-docs.ts --check && node scripts/denylist-check.mjs --tracked",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p scripts/tsconfig.json && tsc --noEmit -p src/web/tsconfig.json",
    "docs:config": "tsx scripts/config-docs.ts",
    "roundtrip": "tsx scripts/roundtrip.ts",
    "test-run": "tsx scripts/test-run.ts",
    "test-run-marks": "tsx scripts/test-run-marks.ts",
    "wiki:publish": "tsx scripts/wiki-publish.ts",
    "whats-new": "tsx scripts/whats-new.ts",
    "screenshots": "tsx scripts/screenshots.ts"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@jsquash/webp": "1.5.0",
    "@lezer/highlight": "1.2.5",
    "@lezer/markdown": "1.8.0",
    "hono": "4.13.13",
    "lucide-preact": "1.59.0",
    "minisearch": "7.2.0",
    "preact": "11.0.1",
    "smol-toml": "1.9.1",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.4",
    "@cloudflare/workers-types": "5.20261019.1",
    "@eslint/js": "10.0.1",
    "@preact/preset-vite": "2.10.6",
    "@types/node": "26.6.5",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "playwright": "1.64.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "wrangler": "4.151.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261012.1": true,
    "fsevents@2.3.3": true
  }
}
